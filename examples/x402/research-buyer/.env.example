# Payer wallet for x402 payments (Base). Without it the agent's
# research actions fail closed and pay nothing. Never commit a real key.
STALLROW_WALLET_PRIVATE_KEY=

# Optional: per-task spend cap in USDC (default 0.05)
STALLROW_MAX_TASK_USDC=0.05

# Optional: StallRow base URL override (defaults to the production
# endpoint https://stall-row-production.up.railway.app)
# STALLROW_BASE_URL=

# Model provider key for the agent itself
OPENAI_API_KEY=
